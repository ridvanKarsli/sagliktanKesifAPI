# --- geliştirme varsayılanları (kopyala: cp .env.example .env) ---
KESIF_ENV=dev
KESIF_LOG_LEVEL=INFO
KESIF_LOG_JSON=false

# Veri (geliştirmede de PostgreSQL: docker compose -f docker-compose.dev.yml up -d)
KESIF_DATABASE_URL=postgresql+psycopg://kesif:parola@localhost:5433/kesif
# canlı: postgresql+psycopg://kesif:parola@postgres:5432/kesif
# hızlı deneme için: sqlite:///./kesif.db
# Motorun geçici çalışma dizini (önbellek; kalıcı veri veritabanında). Varsayılan: ~/.cache/kesif
# KESIF_WORK_DIR=/tmp/kesif

# Kuyruk: inprocess (tek süreç) | redis (ayrı worker)
KESIF_QUEUE_BACKEND=inprocess
KESIF_REDIS_URL=redis://localhost:6379/0

# Kimlik: local | oidc | disabled
KESIF_AUTH_MODE=local
KESIF_JWT_SECRET=gelistirme-icin-en-az-32-karakterlik-gizli-anahtar
KESIF_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
KESIF_BOOTSTRAP_ADMIN_PASSWORD=degistir-bunu-1234
# OIDC (Sağlıktan SSO / Keycloak)
# KESIF_OIDC_ISSUER=https://auth.sagliktan.com/realms/sagliktan
# KESIF_OIDC_AUDIENCE=kesif

# HTTP
KESIF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KESIF_RATE_LIMIT_PER_MINUTE=300
KESIF_DOCS_ENABLED=true

# Dış servisler (isteğe bağlı; makale veritabanı hız sınırını yükseltir)
# KESIF_NCBI_API_KEY=
# KESIF_NCBI_EMAIL=
