# docker compose için (kopyala: cp .env.compose.example .env). Geliştirme ayarları .env.example içinde.
POSTGRES_USER=kesif
POSTGRES_PASSWORD=
POSTGRES_DB=kesif
KESIF_ENV=prod
KESIF_JWT_SECRET=
KESIF_AUTH_MODE=local
KESIF_BOOTSTRAP_ADMIN_EMAIL=
KESIF_BOOTSTRAP_ADMIN_PASSWORD=
KESIF_CORS_ORIGINS=https://kesif.sagliktan.com
KESIF_DOCS_ENABLED=false
# KESIF_OIDC_ISSUER=
# KESIF_OIDC_AUDIENCE=
# KESIF_NCBI_API_KEY=
# KESIF_NCBI_EMAIL=
HTTP_PORT=80
# Frontend reposunun yolu (derleme için) ya da hazır imaj adı
# FRONTEND_CONTEXT=../frontend
# FRONTEND_IMAGE=sagliktan-kesif-web:latest
